{
  "name": "runner-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Runner (Express + Sequelize + PostgreSQL)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "NODE_ENV=test node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "sequelize db:migrate"
  },
  "dependencies": {
    "express": "~5.3.0",
    "pg": "~8.23.1",
    "sequelize": "~6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/express": "~5.0.6",
    "@types/node": "~26.6.5",
    "@types/supertest": "~7.2.1",
    "eslint": "~9.39.5",
    "globals": "~17.13.0",
    "sequelize-cli": "~6.6.5",
    "supertest": "~7.3.1",
    "typescript": "~5.9.3"
  }
}
