{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["src/**/*.js", "tests/**/*.js", "migrations/**/*.js", "*.config.js"],
  "exclude": ["node_modules"]
}
